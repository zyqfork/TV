<resources>

    <!-- Fixed dark theme: white labels remain readable in either system mode, without deriving
         theme colours from the application wallpaper or Android Material You wallpaper colours. -->
    <style name="Theme.Base" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:colorBackground">@color/page_background</item>
        <item name="android:windowBackground">@color/page_background</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="windowSplashScreenBackground">@color/page_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="Theme.App" parent="Theme.Base" />

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/grey_700</item>
    </style>

    <!-- Text shadow for white-on-video text. The cast pages are shared with the TV flavour now,
         so the phone needs the same style the leanback source set already defines. -->
    <style name="Shadow">
        <item name="android:shadowColor">#B0000000</item>
        <item name="android:shadowDx">1.5</item>
        <item name="android:shadowDy">1.5</item>
        <item name="android:shadowRadius">2</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/yellow</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">8dp</item>
    </style>

    <!-- ToolbarTextAppearance moved to main: the cast settings pages are shared with the leanback
         flavour, so the style has to resolve in both. -->

</resources>
