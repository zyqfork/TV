<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Representative colour of the brighter half of each built-in wallpaper shipped in THIS
         source set. The mobile and leanback sets ship different images under the same
         wallpaper_N name, so each flavour carries its own table; sampling the art at runtime
         instead would decode a bitmap on every activity enter. -->
    <integer-array name="wall_art">
        <item>0x00000000</item>
        <item>0xFF71B53E</item>
        <item>0xFF586DE6</item>
        <item>0xFF6CB264</item>
        <item>0xFF42189E</item>
    </integer-array>

</resources>
