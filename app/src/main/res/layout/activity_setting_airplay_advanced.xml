    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- GONE on the TV flavour: the phone flavour shows it and calls setSupportActionBar().
         The leanback source set has no title bar, so leaving it hidden keeps TV unchanged. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:visibility="gone"
        app:contentInsetEnd="16dp"
        app:navigationIconTint="@android:color/white"
        app:title="@string/setting_airplay_advanced"
        app:titleTextAppearance="@style/ToolbarTextAppearance"
        />

