<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Darkened just enough for white text, shared by image/GIF/video wallpapers. The alpha is
         derived from the art's own brightness by CustomWallView, so it stays out of the way for
         dark art instead of flattening every wallpaper to the same near-black. -->
    <View
        android:id="@+id/scrim"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>